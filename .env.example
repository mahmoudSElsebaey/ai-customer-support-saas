# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database — MongoDB (required)
# Local: mongodb://127.0.0.1:27017/voxly
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/voxly?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/voxly

# JWT — use long random secrets in production (min 32 chars)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI (optional — enables AI chat, suggestions, RAG embeddings)
OPENAI_API_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
REDIS_URL=
SENTRY_DSN=
